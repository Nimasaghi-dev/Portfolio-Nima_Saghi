# Contact form delivery (Resend — https://resend.com)
#
# Copy to `.env.local` for development, and set the same values in your
# host's environment variables for production (Vercel: Project → Settings
# → Environment Variables). `.env*` is gitignored — never commit real keys.

# Required. Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required. The inbox that receives contact form messages.
CONTACT_TO_EMAIL=nimasaghi.dev@gmail.com

# Optional. Defaults to Resend's shared test sender, which only delivers to
# the address that owns the API key. To send to anyone, verify your own
# domain at https://resend.com/domains and use an address on it, e.g.
# "Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
